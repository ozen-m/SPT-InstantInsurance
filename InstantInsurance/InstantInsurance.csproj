<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>InstantInsurance</RootNamespace>
    <Version>1.1.1</Version>
    <Authors>ozen</Authors>
    <AssemblyName>$(Authors).$(RootNamespace)</AssemblyName>
    <RepositoryUrl>https://github.com/ozen-m/SPT-InstantInsurance</RepositoryUrl>
    <DebugType>portable</DebugType>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/src/</PathMap>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Web" Version="4.1.3" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.*" PrivateAssets="all" />
    <Publicize Include="SPTarkov.Server.Core" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
  </ItemGroup>

  <PropertyGroup>
<!--    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>-->
  </PropertyGroup>

  <Target Name="SetOutput" AfterTargets="Build">
    <PropertyGroup>
      <DestDir>SPT_Runtime\user\mods\$(Authors).$(SolutionName)</DestDir>
    </PropertyGroup>
    <ItemGroup>
      <OutputDLL Include="$(TargetPath)" />
      <OutputDLL Include="$(TargetDir)$(TargetName).pdb" />
      <Config Include="$(TargetDir)\config\**\*" />
    </ItemGroup>
  </Target>
</Project>
